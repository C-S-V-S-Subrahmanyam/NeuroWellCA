# NeuroWellCA Environment Variables (SECRETS ONLY)
# =====================================================
# This file contains ONLY sensitive credentials that should NEVER be committed to git
# Non-sensitive configuration is in config.toml
# Copy this file to .env and fill in your actual secrets
# =====================================================

# Security Keys (Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=your_secret_key_here_minimum_32_characters
JWT_SECRET_KEY=your_jwt_secret_key_here_minimum_32_characters

# Database (Override config.toml for production)
# DATABASE_URL=postgresql://user:password@host:5432/database

# Twilio WhatsApp (REQUIRED for guardian crisis alerts)
# Get credentials at: https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Optional Production Overrides
# DEBUG=False
# LOG_LEVEL=INFO
# OLLAMA_API_URL=http://production-ollama:11434
